local function buildOption(nombre, typeId, parentScroll, code, valueEnabled, valueDefault, targetCat)
	local optionData = {
		Name = nombre,
		TypeId = typeId or 1,
		Code = code or "",
		ValueEnabled = valueEnabled == true,
		ValueDefault = tonumber(valueDefault) or 0
	}

	if targetCat then
		table.insert(targetCat.Options, optionData)
	end

	local cont = Instance.new("Frame")
	cont.Size = UDim2.new(1, -10, 0, 38)
	cont.BackgroundColor3 = Color3.fromRGB(18, 24, 34)
	cont.Parent = parentScroll

	cr(cont, 6)
	st(cont, Color3.fromRGB(30, 40, 50), 1)
	optionData.Frame = cont

	local mainBtn = Instance.new("TextButton", cont)
	mainBtn.Size = UDim2.new(1, 0, 1, 0)
	mainBtn.BackgroundTransparency = 1
	mainBtn.Text = ""

	local estado = false

	local function triggerAction(newState)
		estado = newState
		activeOptionsRegistry[optionData] = estado and optionData or nil

		if typeId == 1 then
			local bg = cont:FindFirstChildWhichIsA("Frame", true)
			local circle = bg and bg:FindFirstChildWhichIsA("Frame")
			if bg and circle then
				tw(bg, 0.3, {
					BackgroundColor3 = estado and Color3.fromRGB(0, 170, 255) or Color3.fromRGB(30, 40, 50)
				})
				tw(circle, 0.3, {
					Position = estado and UDim2.new(1, -18, 0.5, -8) or UDim2.new(0, 2, 0.5, -8)
				})
			end
		elseif typeId == 3 then
			local lbl = cont:FindFirstChildWhichIsA("TextLabel")
			if lbl then
				if estado then
					lbl.Text = "[ON] " .. nombre
					lbl.TextColor3 = Color3.fromRGB(0, 220, 255)
					cont.BackgroundColor3 = Color3.fromRGB(24, 38, 55)
				else
					lbl.Text = "[OFF] " .. nombre
					lbl.TextColor3 = Color3.fromRGB(150, 160, 175)
					cont.BackgroundColor3 = Color3.fromRGB(18, 24, 34)
				end
			end
		elseif typeId == 2 then
			cont.BackgroundColor3 = Color3.fromRGB(0, 170, 255)
			tw(cont, 0.4, { BackgroundColor3 = Color3.fromRGB(18, 24, 34) })
		end

		ejecutarCodigoConsola(optionData.Code, newState, optionData.ValueDefault)
	end

	if typeId == 1 then
		local lbl = Instance.new("TextLabel", cont)
		lbl.Size = UDim2.new(1, -60, 1, 0)
		lbl.Position = UDim2.fromOffset(10, 0)
		lbl.BackgroundTransparency = 1
		lbl.Text = nombre
		lbl.Font = Enum.Font.Gotham
		lbl.TextColor3 = Color3.new(1, 1, 1)
		lbl.TextXAlignment = Enum.TextXAlignment.Left

		local bg = Instance.new("Frame", cont)
		bg.Size = UDim2.new(0, 40, 0, 20)
		bg.Position = UDim2.new(1, -48, 0.5, -10)
		bg.BackgroundColor3 = Color3.fromRGB(30, 40, 50)
		cr(bg, 10)

		local circle = Instance.new("Frame", bg)
		circle.Size = UDim2.new(0, 16, 0, 16)
		circle.Position = UDim2.new(0, 2, 0.5, -8)
		circle.BackgroundColor3 = Color3.new(1, 1, 1)
		cr(circle, 8)
	elseif typeId == 2 then
		local lbl = Instance.new("TextLabel", cont)
		lbl.Size = UDim2.new(1, -20, 1, 0)
		lbl.Position = UDim2.fromOffset(10, 0)
		lbl.BackgroundTransparency = 1
		lbl.Text = "▶ " .. nombre
		lbl.Font = Enum.Font.Gotham
		lbl.TextColor3 = Color3.new(1, 1, 1)
		lbl.TextXAlignment = Enum.TextXAlignment.Left
	elseif typeId == 3 then
		local lbl = Instance.new("TextLabel", cont)
		lbl.Size = UDim2.new(1, -20, 1, 0)
		lbl.Position = UDim2.fromOffset(10, 0)
		lbl.BackgroundTransparency = 1
		lbl.Text = "[OFF] " .. nombre
		lbl.Font = Enum.Font.Gotham
		lbl.TextColor3 = Color3.fromRGB(150, 160, 175)
		lbl.TextXAlignment = Enum.TextXAlignment.Left
	end

	local touchStartPos = nil
	mainBtn.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			touchStartPos = input.Position
		end
	end)

	mainBtn.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			if touchStartPos then
				local delta = (input.Position - touchStartPos).Magnitude
				if delta < 15 then
					playClickFeedback()
					if typeId == 2 then
						triggerAction(true)
					else
						triggerAction(not estado)
					end
				end
				touchStartPos = nil
			end
		end
	end)

	if optionData.ValueEnabled then
