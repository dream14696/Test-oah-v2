local function ejecutarCodigoConsola(codigo, estado, valor)
	if not codigo or string.match(codigo, "^%s*$") then
		return
	end

	local envHeader = string.format(
		"local state = %s\nlocal estado = %s\nlocal value = %s\nlocal valor = %s\nlocal Player = game:GetService('Players').LocalPlayer\nlocal Players = game:GetService('Players')",
		tostring(estado or false),
		tostring(estado or false),
		tostring(valor or 0),
		tostring(valor or 0)
	)

	local func, err = loadstring(envHeader .. "\n" .. codigo)

	if func then
		task.spawn(func)
	else
		warn("[Error en el script]:", err)
	end
end

local categories = {}
local activeOptionsRegistry = {}

local function switchCategory(catData)
	CurrentCatTitle.Text = catData.Name

	for _, v in pairs(categories) do
		v.Scroll.Visible = false
		v.Btn.BackgroundColor3 = Color3.fromRGB(18, 24, 36)
	end

	catData.Scroll.Visible = true
	catData.Btn.BackgroundColor3 = Color3.fromRGB(0, 120, 225)
end

local function updateSearchResults()
	for _, child in ipairs(SearchResultsScroll:GetChildren()) do
		if child:IsA("TextButton") then child:Destroy() end
	end

	local query = string.lower(SearchInput.Text)
	if query == "" then
		SearchResultsScroll.Visible = false
		return
	end

	local count = 0
	for _, cat in ipairs(categories) do
		for _, opt in ipairs(cat.Options) do
			if string.find(string.lower(opt.Name), query, 1, true) then
				count = count + 1
				local item = Instance.new("TextButton")
				item.Size = UDim2.new(1, -4, 0, 26)
				item.BackgroundColor3 = Color3.fromRGB(22, 28, 40)
				item.Text = " " .. opt.Name .. " (" .. cat.Name .. ")"
				item.Font = Enum.Font.Gotham
				item.TextSize = 10
				item.TextColor3 = Color3.fromRGB(200, 220, 255)
				item.TextXAlignment = Enum.TextXAlignment.Left
				item.ZIndex = 1000
				item.Parent = SearchResultsScroll
				cr(item, 4)

				item.MouseButton1Click:Connect(function()
					playClickFeedback()
					switchCategory(cat)
					SearchResultsScroll.Visible = false
					SearchInput.Text = ""

					if opt.Frame then
						local targetY = math.clamp(opt.Frame.Position.Y.Offset - 10, 0, math.max(0, cat.Scroll.AbsoluteCanvasSize.Y - cat.Scroll.AbsoluteSize.Y))
						tw(cat.Scroll, 0.3, { CanvasPosition = Vector2.new(0, targetY) })

						local orig = opt.Frame.BackgroundColor3
						tw(opt.Frame, 0.2, {BackgroundColor3 = Color3.fromRGB(0, 170, 255)})
						task.delay(0.4, function()
							tw(opt.Frame, 0.4, {BackgroundColor3 = orig})
						end)
					end
				end)
			end
		end
	end

	SearchResultsScroll.Visible = (count > 0)
end

SearchInput:GetPropertyChangedSignal("Text"):Connect(updateSearchResults)

