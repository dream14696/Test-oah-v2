local function GenerarScriptFinal()
	local scriptCode = GetBaseTemplate()

	for i, cat in ipairs(categories) do
		scriptCode = scriptCode .. string.format('local cat_%d = createCategory("%s")\n', i, cat.Name)

		for _, opt in ipairs(cat.Options) do
			local valueCode = opt.ValueEnabled and "true" or "false"
			local valueDefault = tostring(opt.ValueDefault or 0)

			scriptCode = scriptCode .. string.format(
				'buildOption("%s", %d, cat_%d.Scroll, [==[\n%s\n]==], %s, %s, cat_%d)\n',
				opt.Name, opt.TypeId, i, opt.Code, valueCode, valueDefault, i
			)
		end
	end

	scriptCode = scriptCode .. "if categories[1] then switchCategory(categories[1]) end\n"
	return scriptCode
end





